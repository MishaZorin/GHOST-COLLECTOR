{
  "manifest_version": 3,
  "name": "GHOST_COLLECTOR",
  "version": "1.0",
  "description": "A simple Chrome extension",

  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "index.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "icons": {
    "128": "icons/ava.jpeg"
  }
}